# Unified PMG Tracking Center configuration

# PMG node names must match the cluster node names used in the API path:
#   /api2/json/nodes/{node}/tracker
PMG_NODES=pmg1,pmg2,pmg3

# Global TLS verification for PMG nodes. Prefer true + install the PMG CA.
# Set to false only when your PMG nodes use self-signed certs you can't verify yet.
PMG_VERIFY_TLS=true

# Per-node URLs and authentication.
# Node env var prefix is derived from node name: uppercase, '-' -> '_'
#
# PMG commonly uses **tickets** (username/password). API tokens are not always available in the UI.
# Provide EITHER:
# - PMG_<NODE>_TOKEN (if you have tokens working), OR
# - PMG_<NODE>_USERNAME + PMG_<NODE>_PASSWORD (recommended; works everywhere)
#
# Token format (if used):
#   user@realm!tokenid=secret
#
# IMPORTANT: do not commit real passwords/tokens.
PMG_PMG1_URL=https://pmg1.example.com:8006
PMG_PMG1_USERNAME=tracker@pmg
PMG_PMG1_PASSWORD=CHANGE_ME
# PMG_PMG1_TOKEN=tracker@pmg!tracking=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

PMG_PMG2_URL=https://pmg2.example.com:8006
PMG_PMG2_USERNAME=tracker@pmg
PMG_PMG2_PASSWORD=CHANGE_ME
# PMG_PMG2_TOKEN=tracker@pmg!tracking=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

PMG_PMG3_URL=https://pmg3.example.com:8006
PMG_PMG3_USERNAME=tracker@pmg
PMG_PMG3_PASSWORD=CHANGE_ME
# PMG_PMG3_TOKEN=tracker@pmg!tracking=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional per-node TLS override (defaults to PMG_VERIFY_TLS when unset)
# PMG_PMG1_VERIFY_TLS=true
# PMG_PMG2_VERIFY_TLS=true
# PMG_PMG3_VERIFY_TLS=true

# Optional app-level Basic Auth. Leave both empty only behind a trusted authenticated proxy.
APP_USERNAME=
APP_PASSWORD=

# Performance
CACHE_TTL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=20
